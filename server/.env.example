# 数据库（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://dictation:dictation@localhost:5432/dictation
# JWT 签名密钥。留空则首次启动生成随机密钥并写入 .jwt_secret；
# 多实例部署必须显式配置同一个值，否则各实例签发的令牌互不认。
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# CORS，逗号分隔；生产环境走同源反代时可留 *
CORS_ORIGINS=*
# 识别阈值（置信度 0~1），按真实笔迹样本校准
MIN_CONF=0.5
# 判定模式：conservative（只自动判正确，其余待确认，推荐）/ standard（也自动判错字）
VERDICT_MODE=conservative
# 内置管理员（仅在账号不存在时创建）。密码留空则随机生成并打印到启动日志，
# 登录后请在「修改密码」中替换。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
